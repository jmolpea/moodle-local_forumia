# ---------------------------------------------------------------------------
# Secrets — NEVER commit these.
# license_private.key signs licence keys for this plugin. If it ever reaches a
# commit, rotating the key is mandatory: deleting the commit is not enough,
# and rotation invalidates every licence already issued.
# ---------------------------------------------------------------------------
license_private.key
*.key
*.pem
.env
.env.*

# Internal tooling that must not ship to customers
generate_license.php

